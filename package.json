{
  "name": "dsh-ui-balance",
  "version": "0.1.2",
  "description": "Display DeepSeek API account balance under each assistant turn",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "balance",
    "api-usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasyTZ/dsh-ui-balance.git"
  },
  "homepage": "https://github.com/EasyTZ/dsh-ui-balance#readme",
  "bugs": {
    "url": "https://github.com/EasyTZ/dsh-ui-balance/issues"
  }
}
